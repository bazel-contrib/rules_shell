"""The shell exec toolchain registered by default, which honors `--shell_executable`."""

load("//shell/toolchains:sh_exec_toolchain.bzl", "ShExecToolchainInfo")

# Loaded by the BUILD file generated by sh_config, which is in another
# repository. Not a public API.
visibility("public")

_ShellExecutableInfo = provider(
    doc = "The value of the `--shell_executable` flag.",
    fields = {
        "path": "(str) The path to the shell interpreter, or empty if unset.",
    },
)

def _shell_executable_setting_impl(ctx):
    return [_ShellExecutableInfo(path = ctx.build_setting_value)]

# Only set by _shell_executable_transition, not on the command line.
shell_executable_setting = rule(
    implementation = _shell_executable_setting_impl,
    build_setting = config.string(flag = False),
)

_SHELL_EXECUTABLE_SETTING = str(Label("//shell/private:shell_executable"))

def _shell_executable_transition_impl(settings, _attr):
    shell_executable = settings["//command_line_option:shell_executable"]
    return {
        _SHELL_EXECUTABLE_SETTING: str(shell_executable) if shell_executable else "",
    }

# Copies the value of the native flag into the setting. Bazel 6 can't read the
# path-typed native flag in transitions and fails if it is set.
_shell_executable_transition = transition(
    implementation = _shell_executable_transition_impl,
    inputs = ["//command_line_option:shell_executable"],
    outputs = [_SHELL_EXECUTABLE_SETTING],
)

def _default_sh_exec_toolchain_impl(ctx):
    # Attributes with Starlark transitions are always lists.
    shell_executable = ctx.attr._shell_executable[0][_ShellExecutableInfo].path
    return [
        platform_common.ToolchainInfo(
            sh_exec_toolchain = ShExecToolchainInfo(
                interpreter = shell_executable or ctx.attr.path,
                max_command_length = ctx.attr.max_command_length,
            ),
        ),
    ]

default_sh_exec_toolchain = rule(
    doc = "Like `sh_exec_toolchain`, but uses the shell set with `--shell_executable` if any.",
    attrs = {
        "path": attr.string(mandatory = True),
        "max_command_length": attr.int(mandatory = True),
        "_allowlist_function_transition": attr.label(
            default = "@bazel_tools//tools/allowlists/function_transition_allowlist",
        ),
        "_shell_executable": attr.label(
            default = "//shell/private:shell_executable",
            cfg = _shell_executable_transition,
        ),
    },
    implementation = _default_sh_exec_toolchain_impl,
)

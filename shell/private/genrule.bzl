"""Implementation of `genrule`, see `//shell:genrule.bzl` for docs."""

visibility("public")

def genrule(
        *,
        name,
        outs,
        srcs = None,
        tools = None,
        cmd = None,
        cmd_bash = None,
        cmd_bat = None,
        cmd_ps = None,
        toolchains = None,
        executable = None,
        output_to_bindir = None,
        local = None,
        message = None,
        stamp = None,
        output_licenses = None,
        heuristic_label_expansion = None,
        **kwargs):
    """Generates one or more files using a user-defined shell command.

    Args:
        name: A unique name for this target.
        outs: List of files generated by this rule, relative to the package.
            If `executable` is set, `outs` must contain exactly one label.
        srcs: List of inputs for this rule, such as source files to process.
            They are built in the same configuration as this rule. Their paths
            are available to the command as a space-separated list in
            `$(SRCS)`, individually via `$(location //x:y)` or via `$<` if
            `srcs` contains exactly one file.
        tools: List of tool dependencies for this rule. They are built in the
            exec configuration and their paths are available to the command
            via `$(location //x:y)`. Any binary executed by the command must
            appear in this list rather than in `srcs`.
        cmd: The Bash command to run, which is subject to `$(location)` and
            "Make" variable substitution. This is the fallback of `cmd_bash`,
            `cmd_bat` and `cmd_ps` if none of them are applicable. Commands
            that exceed the maximum command length of the execution platform
            are written to a script that is then executed.
        cmd_bash: The Bash command to run, which takes precedence over `cmd`.
        cmd_bat: The Batch command to run on Windows, which takes precedence
            over `cmd` and `cmd_bash`. It is executed with
            `cmd.exe /S /E:ON /V:ON /D /c` and paths are substituted with
            backslashes as separators.
        cmd_ps: The PowerShell command to run on Windows, which takes
            precedence over `cmd`, `cmd_bash` and `cmd_bat`. It is executed
            with `powershell.exe /c` after allowing unsigned scripts, making
            failing cmdlets stop the command and switching the default encoding
            to UTF-8.
        toolchains: The targets whose "Make" variables the command can access
            or `toolchain_type` targets whose toolchains provide
            `TemplateVariableInfo`.
        executable: Whether the single output is executable, which allows it to
            be run with `bazel run`. Defaults to `False`.
        output_to_bindir: Whether outputs are written to the `bin` directory
            instead of the `genfiles` directory. Defaults to `False`.
        local: Whether the command runs locally without sandboxing, remote
            execution or persistent workers, as with the `local` tag. Defaults
            to `False`.
        message: A progress message shown while the command runs.
        stamp: Whether build information is made available to the command:
            `1` always, `0` never, `-1` only with `--stamp`. Defaults to `0`.
        output_licenses: The licenses of the outputs.
        heuristic_label_expansion: Whether words in the command that look like
            labels of `srcs` or `tools` are replaced with their paths. Defaults
            to `False`.
        **kwargs: Attributes common to all rules, such as `tags` or
            `visibility`.
    """

    # Only forward attributes that are set so that the native rule behaves as
    # if it was used directly. In particular, it rejects None as the value of
    # attributes that don't exist in the current version of Bazel.
    for attr_name, value in [
        ("srcs", srcs),
        ("tools", tools),
        ("cmd", cmd),
        ("cmd_bash", cmd_bash),
        ("cmd_bat", cmd_bat),
        ("cmd_ps", cmd_ps),
        ("toolchains", toolchains),
        ("executable", executable),
        ("output_to_bindir", output_to_bindir),
        ("local", local),
        ("message", message),
        ("stamp", stamp),
        ("output_licenses", output_licenses),
        ("heuristic_label_expansion", heuristic_label_expansion),
    ]:
        if value != None:
            kwargs[attr_name] = value
    native.genrule(
        name = name,
        outs = outs,
        **kwargs
    )
